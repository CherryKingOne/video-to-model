# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generated video data
data/inputs/*
data/outputs/*
!data/inputs/.gitkeep
!data/outputs/.gitkeep

# Raw depth volumes (large; may be written outside data/outputs via --depth-map)
*.mmap
*.mmap.json

# Model checkpoints
models/checkpoints/
models/**/*.pth
models/**/.cache/
.upstream-vda/
